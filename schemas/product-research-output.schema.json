{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://boyi.local/schemas/product-research-output.schema.json",
  "title": "Copywrite Product Research Output",
  "type": "object",
  "required": [
    "schema_version",
    "run_id",
    "status",
    "started_at",
    "ended_at",
    "requested_urls",
    "products",
    "usp_candidates",
    "blocked_claims",
    "budgets",
    "live_ready",
    "manual_check_required"
  ],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "run_id": {"type": "string", "minLength": 1},
    "status": {"enum": ["passed", "failed", "blocked", "escalated"]},
    "started_at": {"type": "string", "format": "date-time"},
    "ended_at": {"type": "string", "format": "date-time"},
    "requested_urls": {
      "type": "array",
      "minItems": 1,
      "maxItems": 20,
      "uniqueItems": true,
      "items": {"type": "string", "format": "uri"}
    },
    "products": {
      "type": "array",
      "items": {"$ref": "#/$defs/product"}
    },
    "usp_candidates": {
      "type": "array",
      "items": {"$ref": "#/$defs/uspCandidate"}
    },
    "blocked_claims": {
      "type": "array",
      "items": {"type": "object", "required": ["claim", "reason"], "properties": {"claim": {"type": "string"}, "reason": {"type": "string"}, "source_url": {"type": "string"}}}
    },
    "budgets": {"type": "object"},
    "unresolved_risks": {"type": "array", "items": {"type": "string"}},
    "live_ready": {"const": false},
    "manual_check_required": {"const": true}
  },
  "$defs": {
    "evidence": {
      "type": "object",
      "required": ["field", "value", "source_url", "source_type", "source_locator", "evidence_text", "captured_at", "confidence"],
      "properties": {
        "field": {"type": "string", "minLength": 1},
        "value": {},
        "source_url": {"type": "string", "format": "uri"},
        "source_type": {"enum": ["json_ld", "page_text", "user_brief", "brand_profile"]},
        "source_locator": {"type": "string", "minLength": 1},
        "evidence_text": {"type": "string", "minLength": 1},
        "captured_at": {"type": "string", "format": "date-time"},
        "confidence": {"enum": ["high", "medium", "low"]},
        "volatile": {"type": "boolean"}
      }
    },
    "product": {
      "type": "object",
      "required": ["requested_url", "source_url", "crawl_status", "facts", "raw_markdown_path"],
      "properties": {
        "requested_url": {"type": "string", "format": "uri"},
        "source_url": {"type": "string", "format": "uri"},
        "crawl_status": {"enum": ["success", "failed", "blocked"]},
        "status_code": {"type": ["integer", "null"]},
        "title": {"type": "string"},
        "facts": {"type": "array", "items": {"$ref": "#/$defs/evidence"}},
        "raw_markdown_path": {"type": ["string", "null"]},
        "error": {"type": "string"}
      }
    },
    "uspCandidate": {
      "type": "object",
      "required": ["product_url", "classification", "feature", "evidence_ids", "functional_benefit", "use_case", "desire", "buying_reason", "confidence"],
      "properties": {
        "product_url": {"type": "string", "format": "uri"},
        "classification": {"enum": ["verified_fact", "selling_point", "usp_candidate", "verified_usp"]},
        "feature": {"type": "string"},
        "evidence_ids": {"type": "array", "minItems": 1, "items": {"type": "string"}},
        "functional_benefit": {"type": "string"},
        "use_case": {"type": "string"},
        "desire": {"type": "string"},
        "buying_reason": {"type": "string"},
        "confidence": {"enum": ["high", "medium", "low"]}
      }
    }
  }
}
